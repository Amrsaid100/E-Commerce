# E-Commerce Backend Environment Variables

# Database
ConnectionStrings__DefaultConnection=Server=your-postgres-server;Database=ecommerce_db;Username=postgres;Password=your_password

# JWT
Jwt__Key=your-very-long-secret-key-at-least-32-characters-long-for-production
Jwt__Issuer=FreeOneIssuer
Jwt__Audience=FreeOneAudience
Jwt__ExpiryMinutes=30

# Email (SMTP)
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=your-email@gmail.com
Email__SmtpPass=your-app-password
Email__FromEmail=your-email@gmail.com
Email__FromName=Free One Store
Email__OwnerNotificationEmail=owner@example.com

# Paymob Payment
Paymob__ApiKey=your-paymob-api-key
Paymob__IntegrationId=your-integration-id
Paymob__IframeId=your-iframe-id
Paymob__HmacSecret=your-hmac-secret

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:10000
